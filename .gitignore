.env
__pycache__/
*.pyc
.DS_Store
.venv/
venv/

# generated artefacts
# NOTE: `models/*.pt` does NOT match subdirectories -- models/archive_195clip/
# held 1.4 GB of checkpoints that would otherwise have been committed.
models/**/*.pt
# JPEG-packed cache staged for Colab upload (~430 MB)
data/packed/
# `data/processed/` alone missed data/processed_w5/ (the isolated 3->5
# experiment cache), which git add -A then swept into a commit.
data/processed*/
# data/metadata/ and data/splits/ are TRACKED (60 KB): they are annotation
# metadata derived from the public AV-ASD CSVs -- no media -- and without them
# the repo cannot train anywhere but the machine that generated them. Colab hit
# exactly that: FileNotFoundError on data/splits/train.txt.
models/*.pt
models/*_train.json
reports/*.png
reports/*_metrics.json
reports/*.log

# never commit dataset media
*.mp4
*.wav
*.mkv
*.webm
